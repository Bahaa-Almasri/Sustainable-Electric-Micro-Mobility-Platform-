{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogFiles": {
    "Enabled": true,
    "Path": "logs/micromobility-.log",
    "RetainedDays": 14
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=micromobility;Username=postgres;Password=CHANGE_ME"
  },
  "App": {
    "Url": "http://0.0.0.0:8000"
  },
  "Jwt": {
    "Secret": "",
    "ExpireDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Reservations": {
    "DefaultTtlMinutes": 15,
    "MinTtlMinutes": 1,
    "MaxTtlMinutes": 60
  },
  "Hangfire": {
    "Enabled": true,
    "Server": {
      "Enabled": true,
      "WorkerCount": 2,
      "ShutdownTimeoutSeconds": 60
    },
    "Dashboard": {
      "Username": "",
      "Password": ""
    }
  },
  "SignalR": {
    "HostHub": true
  },
  "AllowedHosts": "*"
}
