{
  "//": "Copy to appsettings.Development.json (gitignored) and fill in. A Neon URI (postgresql://...) is accepted as-is. Set the EF Database.Command override below to Information to log every SQL statement.",
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://ROLE:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
  },
  "Jwt": {
    "Secret": "at-least-32-characters-of-random-text"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://127.0.0.1:8081",
      "http://localhost:19006"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
